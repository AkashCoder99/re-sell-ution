        {
          "name": "Update Listing",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Campus Bike - Updated\",\n  \"price\": 110,\n  \"city\": \"Gainesville\",\n  \"state\": \"FL\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}"
          }
        },
        {
          "name": "Publish Draft",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
