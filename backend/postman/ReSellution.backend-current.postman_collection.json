              "mode": "raw",
              "raw": "{\n  \"image_url\": \"https://example.com/bike-side.jpg\",\n  \"position\": 1\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/images"
          }
        },
        {
          "name": "Upload Image Multipart",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "position",
                  "value": "0",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/images"
          }
        },
        {
          "name": "Delete Listing",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}"
          }
        }
