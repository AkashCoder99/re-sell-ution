            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/status"
          }
        },
        {
          "name": "Upload Image URL",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
