# Core server settings
PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/resellution?sslmode=disable
TOKEN_SECRET=replace-with-a-strong-random-secret
TOKEN_EXPIRY_HOURS=24
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Password reset / OTP controls
PASSWORD_RESET_EXPIRY_MINUTES=15
PASSWORD_RESET_COOLDOWN_MINUTES=5
PASSWORD_RESET_OTP_DIGITS=6
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_PER_IP=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=60

# SMTP delivery
# Leave SMTP_HOST empty to keep local-development OTP delivery in application logs.
# SMTP_SECURITY options: starttls, tls, none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=ReSellution
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
