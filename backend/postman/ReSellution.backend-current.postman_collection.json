              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.report && json.report.id) pm.collectionVariables.set('reportId', json.report.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
