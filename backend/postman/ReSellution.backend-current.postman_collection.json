        },
        {
          "name": "Mark Listing Sold",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"sold\",\n  \"sold_to_user_id\": \"{{buyerUserId}}\"\n}"
