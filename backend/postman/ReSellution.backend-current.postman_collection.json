{
  "info": {
    "name": "ReSellution Backend API - Current",
    "description": "Import-ready Postman collection for the current ReSellution backend. Covers auth, profiles, categories, draft/active listings, favorites, chat, notifications, listing reports, and B19 admin moderation endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "sellerToken", "value": "" },
    { "key": "buyerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "buyerUserId", "value": "" },
    { "key": "sellerUserId", "value": "" },
    { "key": "listingId", "value": "" },
    { "key": "draftListingId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "reportId", "value": "" },
    { "key": "mockRunId", "value": "" },
    { "key": "mockPassword", "value": "Password123" },
    { "key": "mockSellerEmail", "value": "" },
    { "key": "mockBuyerEmail", "value": "" },
    { "key": "mockAdminEmail", "value": "admin@example.com" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Root",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "OpenAPI YAML",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/openapi.yaml"
          }
        },
        {
          "name": "Swagger Docs",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/docs"
          }
        },
        {
          "name": "Health",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Metrics JSON",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/metrics"
          }
        },
        {
          "name": "Metrics Prometheus",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/metrics/prometheus"
          }
        },
        {
          "name": "Metrics Dashboard",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/metrics/dashboard"
          }
        }
      ]
    },
    {
      "name": "Mock Data Seeder",
      "description": "Run this folder top-to-bottom against a local backend to create realistic test data. Admin moderation requests require an existing admin user because the backend intentionally does not expose a public make-admin endpoint.",
      "item": [
        {
          "name": "Initialize Mock Variables",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString();",
                  "pm.collectionVariables.set('mockRunId', id);",
                  "pm.collectionVariables.set('mockPassword', 'Password123');",
                  "pm.collectionVariables.set('mockSellerEmail', `seller.${id}@example.com`);",
                  "pm.collectionVariables.set('mockBuyerEmail', `buyer.${id}@example.com`);",
                  "pm.collectionVariables.set('mockAdminEmail', pm.collectionVariables.get('mockAdminEmail') || 'admin@example.com');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Register Mock Seller",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('sellerToken', json.token);",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}",
                  "if (json.user && json.user.id) pm.collectionVariables.set('sellerUserId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Mock Seller {{mockRunId}}\",\n  \"email\": \"{{mockSellerEmail}}\",\n  \"password\": \"{{mockPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Register Mock Buyer",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('buyerToken', json.token);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('buyerUserId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Mock Buyer {{mockRunId}}\",\n  \"email\": \"{{mockBuyerEmail}}\",\n  \"password\": \"{{mockPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Seller Profile - Gainesville",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }]
          },
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Mock Seller {{mockRunId}}\",\n  \"city\": \"Gainesville\",\n  \"bio\": \"Friendly local seller with campus pickup.\",\n  \"photo_url\": \"https://images.unsplash.com/photo-1472099645785-5658abf4ff4e\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "Buyer Profile - Gainesville",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
          },
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Mock Buyer {{mockRunId}}\",\n  \"city\": \"Gainesville\",\n  \"bio\": \"Looking for practical local deals.\",\n  \"photo_url\": \"https://images.unsplash.com/photo-1494790108377-be9c29b29330\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "Create Mock Active Listing",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.listing && json.listing.id) pm.collectionVariables.set('listingId', json.listing.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mock Campus Bike {{mockRunId}}\",\n  \"description\": \"A reliable test listing for feed, search, chat, favorites, reports, and sold flows.\",\n  \"condition\": \"good\",\n  \"price\": 120,\n  \"currency\": \"USD\",\n  \"city\": \"Gainesville\",\n  \"state\": \"FL\",\n  \"latitude\": 29.6516,\n  \"longitude\": -82.3248,\n  \"image_urls\": [\n    \"https://images.unsplash.com/photo-1485965120184-e220f721d03e\",\n    \"https://images.unsplash.com/photo-1502744688674-c619d1586c9e\"\n  ],\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings"
          }
        },
        {
          "name": "Create Mock Draft Listing",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.listing && json.listing.id) pm.collectionVariables.set('draftListingId', json.listing.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mock Draft Desk Lamp {{mockRunId}}\",\n  \"description\": \"A complete-but-hidden draft listing for the Drafts dashboard tab.\",\n  \"condition\": \"like_new\",\n  \"price\": 25,\n  \"currency\": \"USD\",\n  \"city\": \"Gainesville\",\n  \"state\": \"FL\",\n  \"image_urls\": [\n    \"https://images.unsplash.com/photo-1507473885765-e6ed057f782c\"\n  ],\n  \"status\": \"draft\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings"
          }
        },
        {
          "name": "Buyer Favorites Mock Listing",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
          },
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/favorites/{{listingId}}"
          }
        },
        {
          "name": "Buyer Starts Conversation",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.conversation && json.conversation.id) pm.collectionVariables.set('conversationId', json.conversation.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listing_id\": \"{{listingId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/chat/conversations"
          }
        },
        {
          "name": "Buyer Sends Message",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
          },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hi, can I pick this up near campus today?\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/chat/conversations/{{conversationId}}/messages"
          }
        },
        {
          "name": "Buyer Reports Mock Listing",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.report && json.report.id) pm.collectionVariables.set('reportId', json.report.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"suspicious_price\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/listings/{{listingId}}/report"
          }
        },
        {
          "name": "Admin Login for Moderation",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('adminToken', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mockAdminEmail}}\",\n  \"password\": \"{{mockPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
