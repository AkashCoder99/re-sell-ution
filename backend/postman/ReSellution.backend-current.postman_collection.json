    {
      "name": "Admin Moderation",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "List Reports",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const first = json.reports && json.reports[0];",
                  "if (first && first.id) pm.collectionVariables.set('reportId', first.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/reports?status=open&page=1&limit=20"
          }
        },
        {
          "name": "Get Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/reports/{{reportId}}"
          }
        },
        {
          "name": "Set Report In Review",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_review\",\n  \"resolution_note\": \"Review started.\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/reports/{{reportId}}"
          }
        },
        {
          "name": "Add Moderation Action",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action_type\": \"note\",\n  \"payload\": {\n    \"note\": \"Checked listing and seller history.\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/reports/{{reportId}}/actions"
          }
        },
        {
          "name": "Resolve Report",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\",\n  \"resolution_note\": \"Resolved after moderation review.\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/reports/{{reportId}}"
          }
        }
      ]
    }
  ]
