            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hi, is this still available?\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/chat/conversations/{{conversationId}}/messages"
          }
        },
        {
          "name": "Mark Conversation Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/chat/conversations/{{conversationId}}/read"
          }
        }
      ]
